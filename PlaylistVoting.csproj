<Project Sdk="Microsoft.NET.Sdk">

    <!-- General Project Properties -->
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <Description>Automation for voting levels in Zeepkist</Description>
        <Version>2.17.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
        <Authors>Hi Im Yolo</Authors>
        <PackageId>yolobolo.playlistvoting</PackageId>
        <ImplicitUsings>disable</ImplicitUsings>
        <Title>Playlist Voting</Title>
        <Product>PlaylistVoting</Product>
    </PropertyGroup>

    <!-- Package References -->
    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.Core" Version="5.*"/>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*"/>
        <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0"/>
        <PackageReference Include="Websocket.Client" Version="4.7.0"/>
        <PackageReference Include="Zeepkist.GameLibs" Version="17.32.1912"/>
        <PackageReference Include="ZeepSDK" Version="2.2.0"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Microsoft.CSharp"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="src\Commands\Local\VoteStartCommand.cs"/>
        <Compile Remove="src\Services\PlaylistService.cs"/>
        <Compile Remove="src\Commands\Remote\VoteRemoveCommand.cs"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="src\Commands\Remote\"/>
        <Folder Include="src\Services\"/>
    </ItemGroup>


    <!-- Post-Build Scripts -->
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Message Importance="high" Text="PostBuild starting. TargetDir: $(TargetDir)"/>
        <PropertyGroup>
            <PluginFolder>C:\Program Files (x86)\Steam\steamapps\common\Zeepkist\BepInEx\plugins\Sideloaded\Plugins\$(ProjectName)</PluginFolder>
        </PropertyGroup>

        <!-- Delete the plugin directory if it exists -->
        <RemoveDir Directories="$(PluginFolder)"/>

        <!-- Create the plugin directory -->
        <MakeDir Directories="$(PluginFolder)"/>

        <!-- Copy the main plugin DLL -->
        <Copy SourceFiles="$(TargetDir)$(ProjectName).dll" DestinationFiles="$(PluginFolder)\$(ProjectName)-$(Version).dll"/>

        <!-- Copy dependencies from NuGet packages -->
        <ItemGroup>
            <DependencyFiles Include="$(TargetDir)*.dll"/>
            <!-- Remove the main DLL since we already copied it with version name -->
            <DependencyFiles Remove="$(TargetDir)$(ProjectName).dll"/>
            
            <!-- Remove known game/unity DLLs to keep the plugin small -->
            <DependencyFiles Remove="$(TargetDir)UnityEngine*.dll"/>
            <DependencyFiles Remove="$(TargetDir)Unity.*.dll"/>
            <DependencyFiles Remove="$(TargetDir)Assembly-CSharp.dll"/>
            <DependencyFiles Remove="$(TargetDir)Zeepkist.dll"/>
            <DependencyFiles Remove="$(TargetDir)ZeepSDK.dll"/>
            <DependencyFiles Remove="$(TargetDir)BepInEx*.dll"/>
            <DependencyFiles Remove="$(TargetDir)Mono.*.dll"/>
            <DependencyFiles Remove="$(TargetDir)mscorlib.dll"/>
            <DependencyFiles Remove="$(TargetDir)netstandard.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.Core.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.Data*.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.Drawing.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.Xml*.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.Numerics.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.Configuration.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.Security.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.Transactions.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.ServiceModel.Internals.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.Runtime.Serialization.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.EnterpriseServices.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.ComponentModel.Composition.dll"/>
            <DependencyFiles Remove="$(TargetDir)System.IO.Compression.FileSystem.dll"/>
            <DependencyFiles Remove="$(TargetDir)Microsoft.CSharp.dll"/>
            
            <!-- Explicitly keep those we know we added via NuGet that might have been removed by generic patterns if we had any -->
            <ToKeep Include="$(TargetDir)System.Reactive.dll"/>
            <ToKeep Include="$(TargetDir)System.Threading.Channels.dll"/>
            <ToKeep Include="$(TargetDir)System.Threading.Tasks.Extensions.dll"/>
            <ToKeep Include="$(TargetDir)System.ValueTuple.dll"/>
            <ToKeep Include="$(TargetDir)System.Runtime.CompilerServices.Unsafe.dll"/>
            <ToKeep Include="$(TargetDir)System.Buffers.dll"/>
            <ToKeep Include="$(TargetDir)System.Memory.dll"/>
            <ToKeep Include="$(TargetDir)System.Numerics.Vectors.dll"/>
            <ToKeep Include="$(TargetDir)System.Net.Http.Formatting.dll"/>
        </ItemGroup>

        <Copy SourceFiles="@(DependencyFiles);@(ToKeep)" DestinationFolder="$(PluginFolder)" SkipUnchangedFiles="true" ContinueOnError="true"/>

        <!-- Create a zip file from the directory -->
        <Exec Command="powershell -Command &quot;Compress-Archive -Path &quot;'$(PluginFolder)\*'&quot; -DestinationPath &quot;'$(PluginFolder)-$(Version).zip'&quot; -Force&quot;"/>
    </Target>


    <!-- Enable debug logging -->
    <PropertyGroup>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
    </PropertyGroup>
</Project>
